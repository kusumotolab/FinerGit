<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.out</target>
    <encoder>
      <pattern>%d{YYYY-MM-dd HH:mm:ss} %-7([%level]) %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 複数のスレッドが同じ内容のオブジェクトを同時に書き込むと，Windows では jgit が
       AccessDeniedException を ERROR で記録する（eclipse-jgit/jgit#288）．
       FinerGitRewriter が再実行して復旧するため，この記録はノイズにしかならない．
       復旧できなかった場合は ObjectWritingException が送出されるので見落とすことはない． -->
  <logger name="org.eclipse.jgit.internal.storage.file.LooseObjects" level="OFF"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>